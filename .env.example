# Required: Claude API key (or run `ant auth login` and omit this).
ANTHROPIC_API_KEY=

# Optional: override the model used for recommendations/writing.
OUTBOUND_ENGINE_MODEL=claude-opus-5

# Your name/company, used in the agent's system prompt and brief headers.
OUTBOUND_ENGINE_USER_NAME=

# Optional: X (Twitter) API v2 bearer token, for monitoring specific X profiles.
# Get one at https://developer.x.com/
X_BEARER_TOKEN=

# Optional: dotted path "package.module:ClassName" to your own
# outbound_engine.connectors.linkedin.LinkedInProvider implementation, wired
# to a compliant, licensed LinkedIn data provider. Leave unset to skip
# LinkedIn monitoring unless you're feeding it manual exports instead.
LINKEDIN_PROVIDER_MODULE=

# Optional: where SQLite state and generated briefs live.
OUTBOUND_ENGINE_DATA_DIR=./data
OUTBOUND_ENGINE_OUTPUT_DIR=./output

# Optional: tuning knobs.
OUTBOUND_ENGINE_NEWS_LIMIT=5
OUTBOUND_ENGINE_HTTP_TIMEOUT=10
OUTBOUND_ENGINE_GIT_DAYS=7
